# Node
node_modules/
dist/
dist-ssr/
*.local
coverage/

# Rust
target/
**/*.rs.bk

# Tauri
src-tauri/gen/
# Third-party tools fetched by scripts/fetch-tools.ps1 and bundled by the installer.
# Verified at fetch time; not vendored, so the repo carries no redistributed binaries.
src-tauri/binaries/
src-tauri/target/

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.log
*.tmp

# Secrets (never commit signing keys)
*.key
*.pem
.env
.env.*
!.env.example

# Downloaded videos. The application saves into the user's Downloads folder by default, but a
# developer testing from the repository root ends up with them here, and they are large.
*.mp4
*.webm
*.mkv
*.m4a

# Updater signing keys. The private half must never reach the repository — losing control of it
# means someone else can sign an update this application will install without asking.
*.key
!**/*.key.pub

# Scratch written by the diagnostic examples into whatever directory they are run from. The
# extractor keeps a metadata cache and drops a report file per warning; neither is ours to keep.
rustypipe_cache.json
rustypipe_reports/
